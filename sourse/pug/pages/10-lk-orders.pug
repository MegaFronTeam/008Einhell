extends ../layout/main.pug

include ../blocks/sLk/_sLk.pug

block variables
	- let  mainPage= 'lk-page'
	- let  bg= null

block title
	- let  title= index.head.title
	title= 'Личный кабинет — Заказы'
block pagecontent
	+parts('header-lk')
	main
		+page-head('Николай','','Личный кабинет','Заказы')
		+sLk('orders')
			+orderHead
			+orderCard({number: '2370', date: '11.06.2025', pay: 'Наличными курьеру', sum: '207 900 ₽', statuses: [{text: 'Не оплачен', mod: 'danger'},{text: 'В обработке', mod: 'wait'}], imgs: ['card-item-1','card-item-4','card-item-6']})
			+orderCard({number: '1243', date: '11.06.2025', pay: 'Наличными курьеру', sum: '207 900 ₽', statuses: [{text: 'Завершен', mod: 'done'}], imgs: ['card-item-1','card-item-4','card-item-6']})
	+parts('footer')
